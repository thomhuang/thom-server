# 1Password references for local development. This file holds no secrets: it is
# just a committed list of op:// field paths. scripts/dev-op.ps1 runs the server
# through `op run --env-file=.env.op`, which resolves these from the vault at
# run time. Never replace a reference with a real value.
#
# Each value lives in its own item in the `thom-dev` vault; every item is a
# LOGIN item with the value in its concealed `password` field.
CF_API_TOKEN=op://thom-dev/CF API TOKEN/password
R2_ACCESS_KEY_ID=op://thom-dev/R2 ACCESS KEY ID/password
R2_SECRET_ACCESS_KEY=op://thom-dev/R2 SECRET ACCESS KEY/password
STRIPE_SECRET_KEY=op://thom-dev/STRIPE SECRET KEY/password
STRIPE_WEBHOOK_SECRET=op://thom-dev/STRIPE WEBHOOK SECRET/password
ADMIN_PASSWORD_HASH=op://thom-dev/ADMIN_PASSWORD_HASH/password
JWT_SECRET=op://thom-dev/JWT SECRET/password
#
# Non-secret config also kept in the vault. These could equally live in
# .env.local; either way the injected environment wins over .env.local.
D1_ACCOUNT_ID=op://thom-dev/D1 ACCOUNT ID/password
D1_DATABASE_ID=op://thom-dev/D1 DATABASE ID/password
