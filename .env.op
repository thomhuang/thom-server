# 1Password references for local development. This file holds no secrets: it is
# just a committed list of op:// field paths. scripts/dev-op.ps1 runs the server
# through `op run --env-file=.env.op`, which resolves these from the vault at
# run time. Never replace a reference with a real value.
#
# Each value lives in its own item in the `thom-dev` vault as a password-type
# item, so the field is always `password`. Local runs point at the TEST
# resources, so TEST items are preferred.
# The D1 token is account-scoped, so this single token works for both databases;
# the database is chosen by D1_DATABASE_ID.
CF_API_TOKEN=op://thom-dev/CF API TOKEN/password
R2_ACCESS_KEY_ID=op://thom-dev/TEST R2 Listing Images Access ID/password
R2_SECRET_ACCESS_KEY=op://thom-dev/TEST R2 Listing Images Secret Access Key/password
STRIPE_SECRET_KEY=op://thom-dev/TEST STRIPE SECRET KEY/password
STRIPE_WEBHOOK_SECRET=op://thom-dev/TEST STRIPE WEBHOOK SECRET/password
EMAIL_API_TOKEN=op://thom-dev/EMAIL SENDING API/password
ADMIN_PASSWORD_HASH=op://thom-dev/ADMIN PASSWORD HASH/password
JWT_SECRET=op://thom-dev/TEST JWT SECRET/password
#
# Non-secret resource config, referenced from the vault so .env.local does not
# have to carry it. The account is shared by both environments; the database,
# bucket, and public URL are the test values.
D1_ACCOUNT_ID=op://thom-dev/D1 ACCOUNT ID/password
D1_DATABASE_ID=op://thom-dev/TEST D1 DATABASE ID/password
R2_ACCOUNT_ID=op://thom-dev/R2 ACCOUNT ID/password
R2_BUCKET=op://thom-dev/TEST R2 BUCKET/password
R2_PUBLIC_BASE_URL=op://thom-dev/TEST R2 Public Base URL/password
