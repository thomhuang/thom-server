# Bitwarden login items for local development. This file holds no secrets: it
# maps each config variable to a login item in your Bitwarden vault.
# scripts/dev-bw.ps1 reads it and injects each item's password into the server
# process only. Never replace an item reference with a real value.
#
# One login item per variable, the value in the item's password field. Local
# runs point at the TEST resources. Each right-hand side must be the item's
# exact name, username, or id (UUID) — exact matching keeps dev/PRD items with
# similar names apart (see: bw list items).
#   CF_API_TOKEN=CF API TOKEN
#   CF_API_TOKEN=5395b7b6-cc7d-4ceb-9be4-b4d90148332d
CF_API_TOKEN=CF API TOKEN
R2_ACCESS_KEY_ID=TEST R2 Listing Images Access ID
R2_SECRET_ACCESS_KEY=TEST R2 Listing Images Secret Access Key
STRIPE_SECRET_KEY=TEST STRIPE SECRET KEY
STRIPE_WEBHOOK_SECRET=TEST STRIPE WEBHOOK SECRET
EMAIL_API_TOKEN=EMAIL SENDING API
ADMIN_PASSWORD_HASH=ADMIN PASSWORD HASH
JWT_SECRET=TEST JWT SECRET
#
# Non-secret resource config, kept in Bitwarden too so .env.local stays minimal.
D1_ACCOUNT_ID=D1_ACCOUNT_ID
D1_DATABASE_ID=D1_DATABASE_ID_TEST
R2_ACCOUNT_ID=R2 ACCOUNT ID
R2_BUCKET=TEST R2 BUCKET
R2_PUBLIC_BASE_URL=TEST R2 Public Base URL
