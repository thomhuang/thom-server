ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2y$12$replace-with-a-bcrypt-password-hash
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN_URLS=http://localhost:3000,http://localhost:3001
SECURE_COOKIES=false
DB_PATH=./internal/thom.db

# Cloudflare D1 (used when all three of these are set; local runs use DB_PATH).
D1_ACCOUNT_ID=
D1_DATABASE_ID=
CF_API_TOKEN=
D1_ENDPOINT=

# Cloudflare R2 (shop images). R2_ENDPOINT is for tests only; leave it unset.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Stripe (shop checkout). Use test keys locally; the webhook secret comes from
# the endpoint or `stripe listen`. Tax stays off unless tax registrations exist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
STRIPE_SHIPPING_CENTS=0
