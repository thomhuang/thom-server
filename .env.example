ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2y$12$replace-with-a-bcrypt-password-hash
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN_URLS=http://localhost:3000,http://localhost:3001
SECURE_COOKIES=false

# Cloudflare D1. Required: the server has no local database, so it refuses to
# start unless all three are set. The non-secret values below are the test
# environment's (see wrangler.test.jsonc); production lives in wrangler.jsonc.
# Fill CF_API_TOKEN with a D1-scoped token.
D1_ACCOUNT_ID=d267f5667d69d024b78f3435e213c77d
D1_DATABASE_ID=de8610e7-76af-427b-a228-a742babcb989
CF_API_TOKEN=
D1_ENDPOINT=

# Cloudflare R2 (shop images). The values below are the test bucket's; the
# production bucket lives in wrangler.jsonc. R2_ENDPOINT is for tests only;
# leave it unset.
R2_ACCOUNT_ID=d267f5667d69d024b78f3435e213c77d
R2_BUCKET=listing-images-test
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-9a8dcf30844143e6a0515c4feb4987f9.r2.dev

# Stripe (shop checkout). Use test keys locally; the webhook secret comes from
# the endpoint or `stripe listen`. Tax stays off unless tax registrations exist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
STRIPE_SHIPPING_CENTS=0
