# Copy to .env.local for local development. This file holds NON-SECRET config
# only; secrets come from 1Password. Run the server with scripts/dev-op.ps1,
# which injects CF_API_TOKEN, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, EMAIL_API_TOKEN,
# ADMIN_PASSWORD_HASH, and JWT_SECRET from the vault. See README.md.
ADMIN_USERNAME=admin
CLIENT_ORIGIN_URLS=http://localhost:3000,http://localhost:3001
SECURE_COOKIES=false

# Cloudflare D1. Required: the server has no local database, so it refuses to
# start unless the account id, database id, and CF_API_TOKEN are all set. The
# non-secret values below are the test environment's (see wrangler.test.jsonc);
# production lives in wrangler.jsonc. CF_API_TOKEN comes from 1Password.
D1_ACCOUNT_ID=d267f5667d69d024b78f3435e213c77d
D1_DATABASE_ID=de8610e7-76af-427b-a228-a742babcb989
D1_ENDPOINT=

# Cloudflare R2 (shop images). The values below are the test bucket's; the
# production bucket lives in wrangler.jsonc. R2_ENDPOINT is for tests only;
# leave it unset. R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY come from 1Password.
R2_ACCOUNT_ID=d267f5667d69d024b78f3435e213c77d
R2_BUCKET=listing-images-test
R2_PUBLIC_BASE_URL=https://pub-9a8dcf30844143e6a0515c4feb4987f9.r2.dev

# Stripe (shop checkout). STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET come from
# 1Password. Tax stays off unless tax registrations exist.
STRIPE_TAX_ENABLED=false
STRIPE_SHIPPING_CENTS=1000

# Cloudflare Email Service (buyer order links). EMAIL_API_TOKEN comes from
# 1Password. Order email stays disabled until EMAIL_ACCOUNT_ID, EMAIL_FROM, and
# the token are all set. PUBLIC_SITE_URL is optional and defaults to the first
# client origin.
EMAIL_ACCOUNT_ID=d267f5667d69d024b78f3435e213c77d
EMAIL_FROM=orders@thomhuang.com
EMAIL_FROM_NAME=Thom Huang

# Optional operator copy of every paid order. Leave blank to disable. This is a
# plain address, not a secret, but it is kept out of wrangler.jsonc so it can be
# set per environment.
ORDER_NOTIFICATION_EMAIL=
