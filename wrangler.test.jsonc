{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thom-server-test",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "ThomServer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "THOM_SERVER",
        "class_name": "ThomServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ThomServer"]
    }
  ],
  "vars": {
    "CLIENT_ORIGIN_URLS": "https://thom-website-test.thomhuang.workers.dev",
    "D1_ACCOUNT_ID": "d267f5667d69d024b78f3435e213c77d",
    "D1_DATABASE_ID": "de8610e7-76af-427b-a228-a742babcb989",
    "D1_ENDPOINT": "",
    "R2_ACCOUNT_ID": "d267f5667d69d024b78f3435e213c77d",
    "R2_BUCKET": "listing-images-test",
    "R2_PUBLIC_BASE_URL": "https://pub-9a8dcf30844143e6a0515c4feb4987f9.r2.dev",
    "EMAIL_ACCOUNT_ID": "d267f5667d69d024b78f3435e213c77d",
    "EMAIL_FROM": "orders@thomhuang.com",
    "EMAIL_FROM_NAME": "Thom Huang",
    "PUBLIC_SITE_URL": "https://thom-website-test.thomhuang.workers.dev",
    "SECURE_COOKIES": "true",
    "STRIPE_SHIPPING_CENTS": "1000",
    "STRIPE_TAX_ENABLED": "false"
  }
}
