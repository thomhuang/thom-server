# Copy to .dev.vars for local `wrangler dev` (requires Docker running).
# These are passed to the Go container as environment variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2y$12$replace-with-a-bcrypt-password-hash
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN_URLS=http://localhost:3000,http://localhost:3001
SECURE_COOKIES=false
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_ENDPOINT=
CF_API_TOKEN=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
STRIPE_SHIPPING_CENTS=0
